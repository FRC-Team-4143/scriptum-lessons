<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="PickupAndScore">
  <BehaviorTree ID="PickupAndScore">
    <Sequence>
      <FollowPath trajectory="ToPickup"/>
      <Sleep msec="500"/>
      <FollowPath trajectory="ToScore"/>
      <Timeout msec="3000">
        <SetWantedState state="AIM"/>
      </Timeout>
      <SetWantedState state="SHOOT"/>
      <Sleep msec="2000"/>
      <SetWantedState state="AUTO"/>
    </Sequence>
  </BehaviorTree>
</root>
