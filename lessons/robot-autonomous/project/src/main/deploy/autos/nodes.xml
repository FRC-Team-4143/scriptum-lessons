<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <TreeNodesModel>
    <!-- Robot nodes: the actions this robot's autos can use, from frc/robot/autos/AutoNodes.java
         (Sequence, Fallback, Timeout, Sleep and the other BehaviorTree.CPP nodes are built into
         Arbor) -->
    <Action ID="SetWantedState">
      <input_port name="state" type="WantedState">Robot state to request</input_port>
      <description>Ask the robot for a state. Instant, like a button press: succeeds at once. To wait for the state, retry IsSystemState</description>
    </Action>
    <Condition ID="IsSystemState">
      <input_port name="state" type="RobotState">Robot state to check</input_port>
      <description>The robot is in the given state right now (SUCCESS), or not (FAILURE)</description>
    </Condition>
    <Action ID="FollowPath">
      <input_port name="trajectory" type="std::string">Name of a Choreo path (deploy/choreo/&lt;name&gt;.traj)</input_port>
      <description>Drive a Choreo path until the end of it is reached</description>
    </Action>
  </TreeNodesModel>
  <!-- The states a "state" setting can be, shown in Arbor as a drop-down list. They must match
       RobotStates in the robot code (RobotConstants.java): the robot reads the state by name.
       WantedState is what SetWantedState may ask for. RobotState adds the states the robot moves
       through on its own (AIMING on the way to AIM, FOLLOW_PATH while a FollowPath drives). -->
  <Enums>
    <Enum type="WantedState">
      <Value name="IDLE"/>
      <Value name="DRIVE"/>
      <Value name="SHOOT"/>
      <Value name="AIM"/>
      <Value name="AUTO"/>
    </Enum>
    <Enum type="RobotState">
      <Value name="IDLE"/>
      <Value name="DRIVE"/>
      <Value name="SHOOT"/>
      <Value name="AIM"/>
      <Value name="AIMING"/>
      <Value name="AUTO"/>
      <Value name="FOLLOW_PATH"/>
    </Enum>
  </Enums>
</root>
