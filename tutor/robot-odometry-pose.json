{
	"steps": [
		{
			"title": "Pose",
			"say": "A **pose** is where the robot is (x, y) and which way it faces. The pose estimator adds up every small wheel movement.",
			"board": {
				"code": "poseEstimator.update(getYaw(), getLeftMeters(), getRightMeters());\npose = poseEstimator.getEstimatedPosition();",
				"marks": [
					{
						"text": "update(",
						"label": "feed it the latest movement"
					},
					{
						"text": "getEstimatedPosition()",
						"label": "where it thinks it is"
					}
				]
			}
		},
		{
			"title": "Start the robot",
			"say": "Your code only runs once it's built and started.",
			"target": {
				"selector": "[data-tour='sim-controls']"
			},
			"waitFor": {
				"target": {
					"selector": "[data-tour='code-status']",
					"text": "Running"
				},
				"hint": "press Start and wait for Running."
			}
		},
		{
			"title": "Enable in Teleop",
			"say": "Pick **Teleop** and press **Enable**. Robot code runs only while it's enabled.",
			"target": {
				"selector": "[data-tour='enable']"
			},
			"waitFor": {
				"target": {
					"selector": "[data-tour='enable'] button",
					"text": "Enabled"
				},
				"hint": "choose Teleop, then Enable."
			}
		},
		{
			"title": "2D Field",
			"say": "Open the 2D Field tab in AdvantageScope.",
			"close": [
				"editor",
				"preview",
				"elastic"
			],
			"open": [
				"scope"
			],
			"target": {
				"pane": "scope",
				"selector": ".tab",
				"text": "2D Field"
			},
			"waitFor": {
				"target": {
					"pane": "scope",
					"selector": ".tab.tab-selected",
					"text": "2D Field"
				},
				"hint": "click the 2D Field tab."
			}
		},
		{
			"title": "Your estimate",
			"say": "Search for `Pose` and drag **Drive/Pose** onto **Poses**.",
			"target": {
				"pane": "scope",
				"selector": ".field-2d-sources.source-list"
			},
			"waitFor": {
				"target": {
					"pane": "scope",
					"selector": ".field-2d-sources.source-list .key-container",
					"text": "Drive/Pose"
				},
				"hint": "drag Drive/Pose onto Poses."
			}
		},
		{
			"title": "The truth",
			"say": "Now drag **Drive/TruePose** on too. The simulator knows where the robot **really** is.",
			"target": {
				"pane": "scope",
				"selector": ".field-2d-sources.source-list"
			},
			"waitFor": {
				"target": {
					"pane": "scope",
					"selector": ".field-2d-sources.source-list .key-container",
					"text": "Drive/TruePose"
				},
				"hint": "drag Drive/TruePose onto Poses."
			}
		},
		{
			"title": "Drive it",
			"say": "Drive a long way. The two robots start together and slowly drift apart: wheels slip and encoders are never perfect. Real robots add cameras and gyros to correct it.",
			"target": {
				"selector": "[data-tour='mode']"
			},
			"cardAt": "top-right"
		}
	]
}
