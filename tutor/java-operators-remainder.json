{
	"steps": [
		{
			"title": "Remainder",
			"say": "`%` gives what's **left over** after dividing.",
			"board": {
				"code": "7 % 2   // 1  (7 = 3*2 + 1)\n8 % 2   // 0  (8 = 4*2 + 0)\n10 % 3  // 1",
				"marks": [
					{
						"text": "7 % 2",
						"label": "1 left over: odd"
					},
					{
						"text": "8 % 2",
						"label": "nothing left over: even"
					}
				]
			}
		},
		{
			"title": "Even, in one line",
			"say": "`==` compares two values and gives back `true` or `false`. So the whole test is one expression, and you can return it directly.",
			"board": {
				"code": "public static boolean isEven(int value) {\n    return value % 2 == 0;\n}",
				"marks": [
					{
						"text": "value % 2",
						"label": "the remainder after halving"
					},
					{
						"text": "== 0",
						"label": "true when nothing's left over"
					}
				]
			}
		},
